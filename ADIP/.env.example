# ADIP frontend environment (copy to .env.local to override).
#
# Data source feature flag (Phase 10). The app defaults to the built-in mock /
# simulation layer. Set to "backend" to read from the FastAPI backend instead.
# Can also be toggled at runtime via localStorage key `adip.dataSource`.
VITE_DATA_SOURCE=mock

# Base URL of the ADIP FastAPI backend (used only in backend mode).
VITE_API_BASE_URL=http://localhost:8000/api/v1
