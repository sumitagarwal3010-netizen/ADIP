# ADIP Backend environment configuration (copy to .env to override defaults).

# Database — defaults to a local SQLite file if unset.
# For PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://adip:adip@localhost:5432/adip
# DATABASE_URL=sqlite:///./adip.db

ENVIRONMENT=development
DEBUG=true
SQL_ECHO=false

# Comma-separated list is also accepted by pydantic-settings for cors_origins.
# CORS_ORIGINS=["http://localhost:5173"]
