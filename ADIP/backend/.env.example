# ADIP Backend — environment template (copy to backend/.env)
# NEVER commit real secrets.

# Database
DATABASE_URL=sqlite:///./adip.db

# Auth — demo | oidc | disabled (prototype bypass for demo/disabled only)
ADIP_AUTH_MODE=demo
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_GROUP_CLAIM=groups
OIDC_ROLE_CLAIM=roles

# Connectors
CONNECTOR_DEFAULT_MOCK=true
CONNECTOR_SYNC_ENABLED=true

# Connector credential env var names (values set in runtime secret store)
JIRA_API_TOKEN_ENV=JIRA_API_TOKEN
GITHUB_TOKEN_ENV=GITHUB_TOKEN
GRAPH_CLIENT_SECRET_VAULT_PATH=secret/adip/graph-client-secret
SNYK_TOKEN_ENV=SNYK_TOKEN

# LLM
LOCAL_LLM_ENABLED=false
LLM_PROVIDER=ollama

# Rate limiting (production)
RATE_LIMIT_ENABLED=false

# Benchmark / capacity planning
ADIP_ENV=development
ADIP_BENCHMARK_MODE=mock
CONNECTOR_MODE=mock
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=
REDIS_ENABLED=false
CAPACITY_PROFILE=small
BENCHMARK_OUTPUT_DIR=docs/examples/performance
BENCHMARK_RETENTION_DAYS=30
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
