# Deployment environment for docker-compose (copy to .env at repo root).

# PostgreSQL
POSTGRES_USER=adip
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=adip

# Backend
ENVIRONMENT=production
DEBUG=false
ADIP_AUTH_MODE=demo
CONNECTOR_DEFAULT_MOCK=true
CONNECTOR_SYNC_ENABLED=true

# Benchmark / capacity planning (no secrets)
ADIP_ENV=production
ADIP_BENCHMARK_MODE=mock
CONNECTOR_MODE=mock
LOCAL_LLM_ENABLED=false
OBJECT_STORAGE_PROVIDER=gcs
OBJECT_STORAGE_BUCKET=adip-artifacts-example
REDIS_ENABLED=true
CAPACITY_PROFILE=medium
BENCHMARK_OUTPUT_DIR=docs/examples/performance
BENCHMARK_RETENTION_DAYS=90
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=false
